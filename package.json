    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.65.0",
    "typescript": "~5.7.2",
